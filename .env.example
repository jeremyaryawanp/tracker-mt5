# Copy to .env and fill in. Never commit .env.
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_HOST=127.0.0.1
APP_PORT=8000

# SQLite for local prototype; PostgreSQL for production / docker compose
DATABASE_URL=sqlite:///./data/tradejournal.db
# DATABASE_URL=postgresql+psycopg://tradejournal:change-me@localhost:5432/tradejournal

DISPLAY_TIMEZONE=Asia/Jakarta
WEEK_START=MONDAY

# Single-user login for the web UI (required when APP_HOST is not 127.0.0.1)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Rate limits (per account per minute for ingest; per IP per 5 minutes for login)
INGEST_RATE_LIMIT_PER_MINUTE=30
LOGIN_ATTEMPTS_PER_WINDOW=5

# Optional LLM narrative for weekly reviews (disabled unless explicitly enabled)
LLM_REVIEWS_ENABLED=false
LLM_API_KEY=
